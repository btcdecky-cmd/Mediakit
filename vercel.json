{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/free-media-toolkit run build",
  "outputDirectory": "artifacts/free-media-toolkit/dist/public",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api(?:/|$)|assets(?:/|$)).*)", "destination": "/index.html" }
  ]
}
